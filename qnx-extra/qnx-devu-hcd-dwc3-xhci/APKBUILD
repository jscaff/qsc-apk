# Maintainer: Terence Ang <taang@qnx.com>
pkgname="qnx-devu-hcd-dwc3-xhci"
_usb_dwc3_version="0.1.0.00060T202605201516L"
pkgver=8.0.5
pkgrel=0
pkgdesc="QNX XHCI-based USB host controller driver for DWC3"
url="https://qnx.com"
arch="aarch64"
license="LicenseRef-QDL-Non-Commercial"
depends="qnx-libslog2"
options="!strip !check !tracedeps"
subpackages="$pkgname-dbg"

source="usb_hcd_xhci_dwc3_$_usb_dwc3_version.qpkg::$QSC_URL/com.qnx.qnx800.target.usb.hcd.xhci.dwc3/$_usb_dwc3_version/download
"
builddir="$srcdir"

_arch_name=aarch64le

prepare() {
   for qpkg in *.qpkg; do
        tar xf $qpkg
   done
}

package() {
    cd "$srcdir"
    install -m 0755 -d  "$pkgdir"/usr/lib/dll

    cp -r target/qnx/$_arch_name/lib/dll/* "$pkgdir"/usr/lib/dll
}

dbg() {
    pkgdesc="$pkgdesc debug symbols and binaries"
    depends="$pkgname=$pkgver-r$pkgrel"

    install -m 0755 -d "$subpkgdir"/usr/bin
    install -m 0755 -d "$subpkgdir"/usr/lib/dll

    amove usr/lib/dll/*.sym
}

sha512sums="
f772f81164df0880539e09ea94f53cc983ee886682b68f766f2804071e9f19eaf2071105e11c8987d8ce6260e983a5075670fac5bea9f955b637523ff379388a  usb_hcd_xhci_dwc3_0.1.0.00060T202605201516L.qpkg
"

