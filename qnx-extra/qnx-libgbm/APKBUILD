pkgname="qnx-libgbm"
# This needs to be keeped in sync with the qnx-screen-{backend}
# This also needs to stay in sync with the gbm.pc file vendored with this package
_screen_common_mesa_version="25.1.1.00046T202510100921L"
pkgver=8.0.4
pkgrel=1
pkgdesc="QNX screen libdrm"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
depends="qnx-libdrm"
options="!strip !tracedeps"
subpackages="$pkgname-dbg $pkgname-dev"
source="
libgbm_$_screen_common_mesa_version.qpkg::$QSC_URL/com.qnx.qnx800.target.screen.board.common_mesa/$_screen_common_mesa_version/download
gbm.pc
"
builddir="$srcdir"
_qarch=$CARCH
if [[ $CARCH == "aarch64" ]]; then
    export _qarch=aarch64le
fi

prepare() {
   for qpkg in *.qpkg; do
        tar xf $qpkg
   done
}

# extglob for trimming out other arch's toolchain
shopt -s extglob
package() {
    mkdir -p "$pkgdir"/usr/lib
    echo "Moving generic /usr"
    cp -r "$srcdir"/target/qnx/usr/* "$pkgdir"/usr 

    echo "Moving arch-specific ($_qarch) /usr"
    cp -r "$srcdir"/target/qnx/$_qarch/usr/* "$pkgdir"/usr
}

dev() {
    default_dev
    install "$srcdir"/gbm.pc -m 0644 -D -t "$subpkgdir"/usr/lib/pkgconfig
}


dbg(){
    amove usr/lib/*.sym
}

sha512sums="
32d9b03e60693629d26ee0024bab3804ece43f61fc9146cc2ba245d6f10e44ea09a00b4f72664ca6414f9778bb89dc82024bba11ac66eb9d72c48ca5d1fad6c2  libgbm_25.1.1.00046T202510100921L.qpkg
f98b0bb9b3e26215e3320c7e74dcde9327c7c1ffa482dc9db8e72ce53d4d04853b47a4bc042abc641a6386707d69163818d48f81a86056bbaf12ef7d781b2e83  gbm.pc
"
