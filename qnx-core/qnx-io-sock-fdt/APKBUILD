# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname="qnx-io-sock-fdt"
pkgver=8.0.5
_iosock_fdt_ver="0.5.0.00015T202605220948L"
pkgrel=0
pkgdesc="io-sock driver for various FDT based NICs"
url="https://qnx.com"
arch="aarch64"
license="LicenseRef-QDL-Non-Commercial"
options="!strip !tracedeps"
depends="qnx-libfdt"
subpackages="$pkgname-dev"
source="
    iosock-fdt_$_iosock_pci_ver.qpkg::$QSC_URL/com.qnx.qnx800.target.net.devsfdt/$_iosock_fdt_ver/download
"
builddir="$srcdir"

prepare() {
    for qpkg in *.qpkg; do
        tar xf $qpkg
    done
}

package() {
    mkdir -p "$pkgdir"

    _qarch=$CARCH
    if [[ $CARCH == "aarch64" ]]; then
        _qarch=aarch64le
    fi
    
    echo "Moving arch-specific ($_qarch) files"
    cp -r "$srcdir"/target/qnx/$_qarch/* "$pkgdir"/


    echo "Relocating bin and lib for a merged /usr"
    mkdir -p "$pkgdir"/usr/lib
    mv "$pkgdir"/lib/* "$pkgdir"/usr/lib/
    rmdir "$pkgdir"/lib
}

dev() {
    default_dev
    amove usr/lib/dll/*.sym
}



sha512sums="
83fcf0bef12a36b753a33943c058e9c056a5ec97289e913f0c3b933324ac2d199bc0f74ee5375a3eb9c4d626f813c090e563e450358e89e3c0ab602fb8aebe13  iosock-fdt_.qpkg
"
