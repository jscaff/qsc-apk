cc3adfe7489891d71f5663865384296614b6c3316d1239b0c764740bd34eec2438c47fb1374e0ce4e052f52cdb6f3305bb90635e78421b56b039451ae294ddac  devsddk_0.5.0.00015T202605220948L.qpkg
"
