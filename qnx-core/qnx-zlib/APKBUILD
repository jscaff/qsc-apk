# Maintainer: Leo Shen <yishen@qnx.com>
pkgname=qnx-zlib
pkgver=8.0.5
pkgrel=0
_qnx_compression_ver=0.4.0.00132T202605281115L
pkgdesc="QNX's own zlib port, DO NOT USE FOR PORTING"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
options="!strip !tracedeps"
subpackages="$pkgname-dbg"
source="qnx-compression-$_qnx_compression_ver.qpkg::$QSC_URL/com.qnx.qnx800.target.base.compression.libz/$_qnx_compression_ver/download"
builddir="$srcdir"

prepare() {
   for qpkg in *.qpkg; do
        tar xf $qpkg
   done
}

package() {
    cd "$srcdir"
    mkdir -p "$pkgdir"/usr
    
    if [[ $CARCH == "aarch64" ]]; then
        _qarch=aarch64le
    elif [[ $CARCH == "x86_64" ]]; then
        _qarch=x86_64
    fi

    mkdir -p "$pkgdir"/usr/lib
    cp -r target/qnx/$_qarch/usr/lib/libz.so.* "$pkgdir"/usr/lib
}

dbg() {
    amove usr/lib/*.sym
}

sha512sums="
8ff0653914074d8a281c45f2d388d3b885fb69fad5c5daba8b9a959fefbd4da31d0bb5526f51184632ca4650e00807cd3032f805908c4341ae2548e2826a2658  qnx-compression-0.4.0.00132T202605281115L.qpkg
"
