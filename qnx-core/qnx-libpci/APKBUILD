pkgname="qnx-libpci"
pkgver=8.0.5
_libpci_version=3.0.4.03075T202605211339L
pkgrel=0
pkgdesc="QNX PCI Library"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
options="!strip !tracedeps"
subpackages="$pkgname-dev"
source="libpci_$_libpci_version.qpkg::$QSC_URL/com.qnx.qnx800.target.pci.lib/$_libpci_version/download
"
builddir="$srcdir"

prepare() {
   for qpkg in *.qpkg; do
        tar xf $qpkg
   done
}

# extglob for trimming out other arch's toolchain
shopt -s extglob
package() {
    mkdir -p "$pkgdir"
    echo "Moving common headers"
    mv "$srcdir"/target/qnx/usr "$pkgdir"
    echo $CARCH
    _qarch=$CARCH
    if [[ $CARCH == "aarch64" ]]; then
        export _qarch=aarch64le
    fi
    mkdir -p "$pkgdir"/usr/lib
    echo "Moving arch-specific ($_qarch) libraries"
    cp -r "$srcdir"/target/qnx/$_qarch/lib/* "$pkgdir"/usr/lib/
}

dev() {
    default_dev

    amove usr/lib/*.sym
}

sha512sums="
3173c5e643236d278fdda84c6f3da8a74a2b68d3a28cce70926e7dfda7bf19df44d829959c26525dd4d2f01609a2ebe3956c1cbd739fcc7590c6ef313906d6a8  libpci_3.0.4.03075T202605211339L.qpkg
"
