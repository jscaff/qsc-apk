pkgname="qnx-pci-strings"
pkgver=8.0.5
_pci_strings_version="3.0.1.03075T202605211339L"
pkgrel=1
pkgdesc="QNX PCI Strings module"
url="https://qnx.com"
arch="all"
license="LicenseRef-QDL-Non-Commercial"
options="!strip !check !tracedeps"
subpackages="$pkgname-dev"
source="pci_strings_$_pci_strings_version.qpkg::$QSC_URL/com.qnx.qnx800.target.pci.uisupport/$_pci_strings_version/download
"
builddir="$srcdir"

prepare() {
   for qpkg in *.qpkg; do
        tar xf $qpkg
   done
}

# extglob for trimming out other arch's toolchain
shopt -s extglob
package() {
    mkdir -p "$pkgdir"
    echo "Moving common headers"
    mv "$srcdir"/target/qnx/usr "$pkgdir"
    mv "$srcdir"/target/qnx/etc "$pkgdir"

    echo $CARCH
    _qarch=$CARCH
    if [[ $CARCH == "aarch64" ]]; then
        export _qarch=aarch64le
    fi

    mkdir -p "$pkgdir"/usr/lib/dll
    echo "Moving arch-specific ($_qarch) libraries"
    cp -r "$srcdir"/target/qnx/$_qarch/lib/dll/pci/* "$pkgdir"/usr/lib/dll
}

dev() {
    default_dev

    amove usr/lib/dll/*.sym
}

sha512sums="
9f60963b9cb988fba3c558005e37f7b636ca822c6124010e283fb06df2770c24442f9d7297b61980e1ddd23c54fac05e9ea005e80f3c274e5a347345bb45ef53  pci_strings_3.0.1.03075T202605211339L.qpkg
"
